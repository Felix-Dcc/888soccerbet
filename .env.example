# --- Database (local PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stakra?schema=public"

# --- App ---
APP_URL="http://localhost:3000"
# 32+ byte secret used to sign session tokens and webhook HMACs. CHANGE THIS.
AUTH_SECRET="dev-only-change-me-to-a-long-random-string-32b+"

# --- Data provider ---
# DATA_PROVIDER selects where fixtures (and odds) come from:
#   thesportsdb  -> REAL fixtures/teams/logos/scores, NO bookmaker odds (free test key "123";
#                   premium key lifts the ~1-event-per-league free-tier cap). Default.
#   theoddsapi   -> REAL fixtures AND real bookmaker odds (needs ODDS_API_KEY, free tier
#                   gives 500 req/mo). This is the path to a bettable, fully-real sportsbook.
#   sandbox      -> simulated demo odds for local development ONLY (refused in production).
DATA_PROVIDER="thesportsdb"
THESPORTSDB_KEY="123"          # free public test key; replace with a premium key for full coverage
ODDS_API_KEY=""                # required only when DATA_PROVIDER=theoddsapi
ODDS_REGION="eu"

ODDS_MARKETS="h2h,spreads,totals"                    # bulk: 1 credit per market per league
# Per-match markets for the top N football matches (1 credit per market the feed returns, per
# match). Default = every market Kingz Bet can settle from the final score:
#   btts,double_chance,draw_no_bet,alternate_totals,team_totals,alternate_spreads,correct_score,odd_even
# Leave unset to get them all; list a subset to save credits.
# ODDS_EXTRA_MARKETS="btts,double_chance,draw_no_bet"
ODDS_EXTRA_FIXTURES="2"   # matches that get the full market list (raise on a paid plan)
ODDS_EXTRA_RESERVE="150"  # pause per-match markets (and suspend their prices) below this many credits

# Worker cadence (ms), sized for The Odds API free tier (500 credits/month) even when the
# worker runs nonstop: a sync is ~27 credits (6 leagues x 3 markets + 3 matches x 3 extras),
# a settle <= 12 (2 per league with an unsettled finished match).
# 48h sync (~405/mo) + 96h settle (<= ~90/mo) ~= 495/mo. Fresher odds need a paid plan.
SYNC_INTERVAL_MS="172800000"    # 48h
SETTLE_INTERVAL_MS="345600000"  # 96h
# Live scores: checked every LIVE_SCORES_INTERVAL_MS, free when nothing is in play, otherwise
# 1 credit per league with a live match. Pauses once credits left <= LIVE_SCORES_RESERVE so the
# odds sync above keeps running. The free tier runs out quickly on busy match days.
LIVE_SCORES_INTERVAL_MS="600000"  # 10 min
LIVE_SCORES_RESERVE="150"

# --- Payments (Mobile Money) ---
# sandbox = simulated MoMo with signed webhooks and idempotency. No real money moves.
# Real providers (e.g. Paystack/Hubtel/Flutterwave) require approved merchant credentials.
PAYMENT_PROVIDER="sandbox"
PAYMENT_WEBHOOK_SECRET="dev-only-change-me-webhook-secret"

# --- Betting window ---
# Started matches are closed to betting because synced pre-match prices go stale at kick-off.
# Set to "true" ONLY with a real in-play odds feed; then status=LIVE fixtures stay open.
LIVE_BETTING="false"
# Timezone for kick-off times and day groups (server and browser must agree).
NEXT_PUBLIC_TIMEZONE="Africa/Accra"

# --- Integration tests ---
# Defaults to <DATABASE_URL db name>_test, wiped and re-migrated each run. Never point at real data.
# TEST_DATABASE_URL="postgresql://user:pass@localhost:5432/stakra_test?schema=public"

# --- Limits (GHS, major units) ---
MIN_STAKE_GHS="250"
MIN_DEPOSIT_GHS="50"
VERIFY_DEPOSIT_GHS="500"
VERIFY_AFTER_WIN_GHS="1000"   # each of the 2 deposits needed before the first withdrawal
MAX_STAKE_GHS="5000"
MAX_PAYOUT_GHS="200000"
MAX_ACCA_LEGS="20"

# House margin on cash out offers (percent of fair value)
CASHOUT_MARGIN_PCT="5"

# Legal pages: operator details shown in the Terms and Privacy Policy (leave blank until registered)
LEGAL_ENTITY=""
LEGAL_ADDRESS=""
LEGAL_EMAIL="support@kingsbet.gh"
GAMING_LICENCE=""
DPC_REGISTRATION=""

# Admin console: public address for referral links, and alert thresholds
SITE_URL=""
STALE_ODDS_HOURS="50"
UNSETTLED_AFTER_HOURS="4"
PENDING_PAYMENT_ALERT_MINUTES="60"
# Sign-ups without a referral code are credited to this administrator's code (blank = left unattributed)
DEFAULT_REFERRAL_CODE=""

# Email via Brevo (sign-up codes, password resets, win/payment notices). Unset = emails are logged, not sent.
BREVO_API_KEY=""
EMAIL_FROM="no-reply@kingzbet.live"
EMAIL_FROM_NAME="Kingz Bet"

# Cloudflare Turnstile on log-in, sign-up and forgot-password. Unset = the check is off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Real payments via Flutterwave (API v3). Keep "sandbox" until the keys below are set.
# PAYMENT_PROVIDER="flutterwave"
FLW_SECRET_KEY=""   # Flutterwave dashboard > Settings > API keys (FLWSECK_TEST-... in test mode)
FLW_SECRET_HASH=""  # the "Secret hash" you type on Flutterwave's webhook settings page

# Real payments via ShinobiPay (deposits only; withdrawals are paid by an admin from the trading desk).
# PAYMENT_PROVIDER="shinobipay"
SHINOBI_SECRET_KEY=""      # ShinobiPay dashboard: sk_test_... (test) / sk_live_... (live)
SHINOBI_WEBHOOK_SECRET=""  # whsec_..., shown once when you register the webhook URL
# SHINOBI_API_URL="https://akwapayapi.onrender.com"  # only if ShinobiPay gives you a different API host
